{
  "name": "@ts-restless/core",
  "version": "4.0.0-alpha.6",
  "private": false,
  "description": "Contract-first, end-to-end typed REST for TypeScript. A maintained fork of ts-rest.",
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "typescript-rest",
    "http",
    "api",
    "type safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2wce/ts-restless.git",
    "directory": "libs/ts-rest/core"
  },
  "license": "MIT",
  "peerDependencies": {
    "@types/node": "^18.18.7 || >=20.8.4",
    "zod": "^3.22.3 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./legacy": "./src/legacy.ts"
  },
  "devDependencies": {
    "@ts-restless/build-config": "workspace:*",
    "zod-legacy": "npm:zod@3.22.3",
    "zod": "catalog:"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      },
      "./legacy": {
        "import": {
          "types": "./dist/legacy.esm.d.mts",
          "default": "./dist/legacy.esm.mjs"
        },
        "require": {
          "types": "./dist/legacy.cjs.d.ts",
          "default": "./dist/legacy.cjs.js"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/2wce/ts-restless/issues"
  },
  "homepage": "https://github.com/2wce/ts-restless#readme",
  "sideEffects": false
}
