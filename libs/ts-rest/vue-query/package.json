{
  "name": "@ts-restless/vue-query",
  "version": "4.0.0-alpha.7",
  "private": false,
  "description": "ts-restless vue-query integration for contract-first, end-to-end typed REST.",
  "keywords": [
    "rpc",
    "rest",
    "typescript",
    "typescript-rest",
    "vue-query",
    "nestjs",
    "http",
    "api",
    "type safe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/2wce/ts-restless.git",
    "directory": "libs/ts-rest/vue-query"
  },
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/vue-query": "^5.0.0",
    "@ts-restless/core": "workspace:^"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "devDependencies": {
    "@ts-restless/core": "workspace:*",
    "@ts-restless/build-config": "workspace:*"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/2wce/ts-restless/issues"
  },
  "homepage": "https://github.com/2wce/ts-restless#readme",
  "dependencies": {
    "vue-demi": "0.14.10"
  },
  "sideEffects": false
}
