{
  "name": "@ts-restless/express",
  "version": "4.0.0-alpha.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/2wce/ts-restless.git",
    "directory": "libs/ts-rest/express"
  },
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "@ts-restless/core": "workspace:^",
    "zod": "^3.22.3 || ^4.0.0"
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "devDependencies": {
    "@ts-restless/core": "workspace:*",
    "@ts-restless/build-config": "workspace:*",
    "zod": "catalog:"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./legacy": "./src/legacy.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      },
      "./legacy": {
        "import": {
          "types": "./dist/legacy.esm.d.mts",
          "default": "./dist/legacy.esm.mjs"
        },
        "require": {
          "types": "./dist/legacy.cjs.d.ts",
          "default": "./dist/legacy.cjs.js"
        }
      }
    }
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/2wce/ts-restless/issues"
  },
  "homepage": "https://github.com/2wce/ts-restless#readme",
  "description": "ts-restless express integration for contract-first, end-to-end typed REST.",
  "sideEffects": false
}
