{
  "name": "@ts-restless/serverless",
  "version": "4.0.0-alpha.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/2wce/ts-restless.git",
    "directory": "libs/ts-rest/serverless"
  },
  "license": "MIT",
  "dependencies": {
    "itty-router": "^5.0.9"
  },
  "peerDependencies": {
    "@azure/functions": "^4.0.0",
    "@types/aws-lambda": "^8.10.115",
    "next": "^15.0.0 || ^16.0.0",
    "@ts-restless/core": "workspace:^",
    "zod": "^3.22.3 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@azure/functions": {
      "optional": true
    },
    "@types/aws-lambda": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit -p tsconfig.assertions.json"
  },
  "devDependencies": {
    "@ts-restless/core": "workspace:*",
    "@ts-restless/build-config": "workspace:*",
    "zod": "catalog:"
  },
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./fetch": "./src/fetch.ts",
    "./aws": "./src/aws.ts",
    "./next": "./src/next.ts",
    "./azure": "./src/azure.ts",
    "./legacy": "./src/legacy.ts"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.mjs",
    "types": "./dist/index.cjs.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": {
          "types": "./dist/index.esm.d.mts",
          "default": "./dist/index.esm.mjs"
        },
        "require": {
          "types": "./dist/index.cjs.d.ts",
          "default": "./dist/index.cjs.js"
        }
      },
      "./fetch": {
        "import": {
          "types": "./dist/fetch.esm.d.mts",
          "default": "./dist/fetch.esm.mjs"
        },
        "require": {
          "types": "./dist/fetch.cjs.d.ts",
          "default": "./dist/fetch.cjs.js"
        }
      },
      "./aws": {
        "import": {
          "types": "./dist/aws.esm.d.mts",
          "default": "./dist/aws.esm.mjs"
        },
        "require": {
          "types": "./dist/aws.cjs.d.ts",
          "default": "./dist/aws.cjs.js"
        }
      },
      "./next": {
        "import": {
          "types": "./dist/next.esm.d.mts",
          "default": "./dist/next.esm.mjs"
        },
        "require": {
          "types": "./dist/next.cjs.d.ts",
          "default": "./dist/next.cjs.js"
        }
      },
      "./azure": {
        "import": {
          "types": "./dist/azure.esm.d.mts",
          "default": "./dist/azure.esm.mjs"
        },
        "require": {
          "types": "./dist/azure.cjs.d.ts",
          "default": "./dist/azure.cjs.js"
        }
      },
      "./legacy": {
        "import": {
          "types": "./dist/legacy.esm.d.mts",
          "default": "./dist/legacy.esm.mjs"
        },
        "require": {
          "types": "./dist/legacy.cjs.d.ts",
          "default": "./dist/legacy.cjs.js"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/2wce/ts-restless/issues"
  },
  "homepage": "https://github.com/2wce/ts-restless#readme",
  "description": "ts-restless serverless integration for contract-first, end-to-end typed REST.",
  "sideEffects": false
}
