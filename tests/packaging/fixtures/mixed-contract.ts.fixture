import { initContract } from '@ts-restless/core';

const c = initContract();
export const contract = c.router({
  empty: {
    method: 'POST',
    path: '/empty',
    body: c.noBody(),
    responses: { 200: c.noBody() },
  },
  plain: {
    method: 'POST',
    path: '/plain',
    body: c.type<{ value: string }>(),
    responses: { 200: c.type<{ value: string }>() },
  },
  nullable: {
    method: 'POST',
    path: '/nullable',
    body: c.type<null>(),
    responses: { 200: c.type<null>() },
  },
});
